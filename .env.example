# Tavik configuration.
#
# Copy to .env.local, then run `npm run hydra:setup` — it fills in HYDRA_TOKEN
# and creates the matching token file on the HydraDB data volume.
#
# Never commit .env.local. It is gitignored.

# ── HydraDB ──────────────────────────────────────────────────────────────────
# The graph/state layer. Tavik stores all security state here and delegates all
# path traversal to HydraDB's native algo.* procedures.
HYDRA_URL=http://127.0.0.1:8443
HYDRA_TOKEN=
HYDRA_GRAPH_ID=default
HYDRA_NAMESPACE=default
HYDRA_CELL_ID=cell-0
HYDRA_TIMEOUT_MS=30000

# ── Demo environment ─────────────────────────────────────────────────────────
# Exposes the labelled DEMO ENVIRONMENT controls, including the state-change
# trigger. The trigger drives the real ingestion and verification pipeline; it
# does not toggle UI state. Set to `false` to hide it.
TAVIK_DEMO_MODE=true

# ── npm registry ─────────────────────────────────────────────────────────────
# The public registry needs no credentials. Override only to point at a mirror
# or a local cache.
NPM_REGISTRY_URL=https://registry.npmjs.org

# ── Slack ────────────────────────────────────────────────────────────────────
# An incoming webhook. Tavik posts only when a rule stops being true or becomes
# true again — never routine checks, because a channel that reports nothing
# changed every minute gets muted, and a muted channel looks like coverage while
# providing none.
SLACK_WEBHOOK_URL=

# Used to build links in those messages.
TAVIK_APP_URL=http://localhost:3000

# ── GitHub ───────────────────────────────────────────────────────────────────
# Optional. Public repositories work without it; a token raises the rate limit
# and allows private repositories.
GITHUB_TOKEN=
