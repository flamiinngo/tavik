# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the documented template and must stay tracked.
.env*
!.env.example

# HydraDB local volume: object store, cache, WALs, and the auth token.
# Never commit this — it contains the bearer token for the local instance.
/.hydradb-data/

# Ingestion working directory: registry snapshots and downloaded manifests.
/.tavik-cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dev server output, written by `npm run dev`.
dev.log

.vercel
